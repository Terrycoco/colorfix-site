# Serve SPA entry point for all routes
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Retired image systems: return Gone even if an old PHP file survives a code-only deployment.
  # Current /admin/photos/upload.php, Photo Library, image-thumb, PVs and PUB are deliberately excluded.
  RewriteRule ^api/v2/(?:photos|mask-training)(?:/|$) - [G,L]
  RewriteRule ^api/v2/admin/(?:mask-blend|photo-tags)(?:/|$) - [G,L]
  RewriteRule ^api/v2/admin/(?:photo-upload|photo-mask-delete|mask-overlay|recalc-mask-overlays|roles-masks|masks-alpha|render-debug|photo-debug|photo-search|photo-list-roles|photos-recalc-lm|reindex-from-fs|share-card-generate)\.php$ - [G,L]
  RewriteRule ^api/v2/admin/photo-library/(?:cleanup-legacy-applied|backfill-exteriors)\.php$ - [G,L]
  RewriteRule ^api/v2/admin/saved-palette-photos/normalize-links\.php$ - [G,L]
  RewriteRule ^api/v2/admin/playlist-items/repair-broken-photo-library\.php$ - [G,L]
  RewriteRule ^api/tools/(?:recalc-mask-overlays|backfill-mask-target-lightness)\.php$ - [G,L]
  RewriteRule ^api/tests/(?:PhotoModuleSmokeTest|PhotoRepoVariantsTest|PhotoRepoCreateUpdateTest)\.php$ - [G,L]
  RewriteRule ^scripts/(?:masks_alpha_check|convert_masks_alpha)\.php$ - [G,L]
  RewriteRule ^render_test\.php$ - [G,L]
  RewriteRule ^admin/(?:roles-masks|upload-photo|palette-photos)/?$ - [G,L]

  # Only the site root uses the prebuilt homepage.
  RewriteRule ^$ /index.html [L]

  RewriteRule ^pod/?$ /pod.php [L,QSA]

  # Picker is a React route, even when an old static picker/ directory exists.
  RewriteRule ^picker/?$ /app-shell.html [L,QSA]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^colorfix/index\.html$ - [L]
  RewriteRule ^qr/?$ /qr.php [L,QSA]

  RewriteRule ^pv/([^/]+)/?$ /pv.php?code=$1 [L,QSA]
  RewriteRule ^t/([^/]+)/?$ /t.php?token=$1 [L,QSA]
  RewriteRule ^playlist/share/id=([0-9]+)/?$ /playlist-share.php?playlist_id=$1 [L,QSA]
  RewriteRule ^playlist/exterior-transformations/?$ /qr [R=302,L,NE,QSA]
  RewriteRule ^playlist/(.+)$ /p/$1 [R=302,L,NE]
  RewriteRule ^playlists/?$ /playlists/index.php [L,QSA]
  RewriteRule ^sitemap\.xml$ /sitemap.php [L,QSA]
  # Serve crawler instructions directly, ahead of the SPA fallback.
  RewriteRule ^robots\.txt$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^playlists/([^/]+)/?$ /playlists/index.php?slug=$1 [L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^colorfix/.*$ /colorfix/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^p(/.*)?$ /player/index.html [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^admin/.*$ /admin/index.html [L]

  RewriteRule ^sas/?$ /sas/index.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^sas/.*$ /sas/index.html [L]

  # Keep the already tested Gallery shell path.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^results/[0-9]+/?$ /gallery-shell.html [L,QSA]

  # All other React routes start from the clean shared app shell.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /app-shell.html [L]
</IfModule>

# Caching rules
<IfModule mod_mime.c>
  AddType text/plain .txt
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Cache JS/CSS and images for 1 year (fingerprinted filenames should change per build)
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # HTML should NOT be cached (forces shells to reload on revisit)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript
</IfModule>
